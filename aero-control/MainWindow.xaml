<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aero Control" Width="1280" Height="820" MinWidth="1040" MinHeight="640" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#151B26" Foreground="#EFF3F9" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A8B4C6"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EFF3F9"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Small" TargetType="TextBlock"><Setter Property="Foreground" Value="#A8B4C6"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EFF3F9"/><Setter Property="Background" Value="#263247"/><Setter Property="BorderBrush" Value="#414F66"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#35435B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B9C6FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Nav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#C5CEDC"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="14,14"/><Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavBg" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavBg" Property="Background" Value="#2B3854"/><Setter TargetName="NavBg" Property="BorderBrush" Value="#9BAEFF"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBg" Property="Background" Value="#253044"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBg" Property="BorderBrush" Value="#B9C6FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#1D2736"/><Setter Property="BorderBrush" Value="#303D50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Mode" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="95"/><Setter Property="Padding" Value="12,12"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EFF3F9"/><Setter Property="Margin" Value="0,10"/><Setter Property="FontSize" Value="14"/></Style>
 </Window.Resources>
 <Border BorderBrush="#38465B" BorderThickness="1" CornerRadius="10">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" BorderBrush="#293447" BorderThickness="0,0,0,1" Background="#18212E" CornerRadius="10,10,0,0">
   <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0"><TextBlock Text="≋" FontSize="28" Foreground="#9BAEFF" Margin="0,-3,13,0"/><TextBlock Text="Aero Control" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#28344A" CornerRadius="4" Padding="7,2" Margin="12,0,0,0"><TextBlock Text="Preview" FontSize="10" Foreground="#B7C6E5" VerticalAlignment="Center"/></Border></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MinimizeButton" Content="—" Width="46" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Minimize"/><Button x:Name="MaximizeButton" Content="□" Width="46" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Maximize or restore"/><Button x:Name="CloseButton" Content="×" FontSize="23" Width="46" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Close"/></StackPanel></Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#111722" BorderBrush="#2B3648" BorderThickness="0,0,1,0"><DockPanel Margin="12,18,12,20"><StackPanel DockPanel.Dock="Bottom" Margin="8,0"><Border Height="1" Background="#2B3648" Margin="0,0,0,18"/><TextBlock x:Name="SidebarModel" Text="Your laptop" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Windows · Community edition" Style="{StaticResource Small}" Margin="0,6,0,0"/></StackPanel><StackPanel><RadioButton x:Name="NavOverview" GroupName="Navigation" Style="{StaticResource Nav}" IsChecked="True" Content="⌂    Overview"/><RadioButton x:Name="NavDevice" GroupName="Navigation" Style="{StaticResource Nav}" Content="▱    Device support"/><RadioButton x:Name="NavSettings" GroupName="Navigation" Style="{StaticResource Nav}" Content="⚙    Settings"/></StackPanel></DockPanel></Border>
   <Grid Grid.Column="1" Margin="26,24,26,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="Overview" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Monitor and control your laptop in one place." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,6,0,18"/></StackPanel><Border Background="#1D302F" BorderBrush="#355C56" BorderThickness="1" CornerRadius="7" Padding="12,7" VerticalAlignment="Top" HorizontalAlignment="Right"><TextBlock x:Name="PowerSource" Text="Power status" Foreground="#8FD6B9" FontSize="12"/></Border></Grid>
    <Border x:Name="NoticeBox" Grid.Row="1" Background="#233047" BorderBrush="#405376" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,18"><TextBlock x:Name="NoticeText" Text="Connecting to your laptop…" Foreground="#B9CBF4" FontSize="12"/></Border>
    <Grid Grid.Row="2">
     <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition/></Grid.RowDefinitions>
        <Grid Margin="4,0,0,12">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="CPU" Foreground="#9BAEFF"/><TextBlock x:Name="CpuTemp" Text="—" FontSize="36" FontWeight="SemiBold"/><TextBlock x:Name="CpuLoad" Text="— utilization" Style="{StaticResource Small}"/></StackPanel>
         <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="GPU" Foreground="#E7B690"/><TextBlock x:Name="GpuTemp" Text="—" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="Temperature" Style="{StaticResource Small}"/></StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="16">
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="80"/></Grid.RowDefinitions>
          <Grid><TextBlock Text="Temperature history" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Range1" Content="1 min" FontSize="11" Padding="8,5" Background="Transparent"/><Button x:Name="Range5" Content="5 min" FontSize="11" Padding="8,5" Background="#394E7B"/><Button x:Name="Range15" Content="15 min" FontSize="11" Padding="8,5" Background="Transparent"/></StackPanel></Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10"><TextBlock Text="━  CPU" Foreground="#9BAEFF" FontSize="12"/><TextBlock Text="━  GPU" Foreground="#E7B690" FontSize="12" Margin="20,0,0,0"/></StackPanel>
          <Grid x:Name="ChartHost" Grid.Row="2" MinHeight="80"/>
          <Border Grid.Row="3" BorderBrush="#344155" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU fan" Style="{StaticResource Small}"/><TextBlock x:Name="CpuRpm" Text="— RPM" FontSize="22" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="GPU fan" Style="{StaticResource Small}"/><TextBlock x:Name="GpuRpm" Text="— RPM" FontSize="22" Margin="0,4,0,0"/></StackPanel></Grid></Border>
         </Grid>
        </Border>
       </Grid>
       <StackPanel Grid.Column="2">
        <Border Style="{StaticResource Panel}" Padding="16">
         <StackPanel>
          <TextBlock Text="Cooling" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="AutoButton" Content="Auto" Padding="8,9" IsEnabled="False" Margin="0,0,5,0"/><Button x:Name="MaxButton" Grid.Column="1" Content="Max" Padding="8,9" IsEnabled="False" Margin="0,0,5,0"/><Button x:Name="CustomButton" Grid.Column="2" Content="Custom" Padding="8,9" IsEnabled="False"/></Grid>
          <TextBlock x:Name="ModeDescription" Text="Checking cooling support…" Style="{StaticResource Small}" Margin="0,9,0,0"/>
          <Border x:Name="CustomPanel" Margin="0,10,0,0" Visibility="Collapsed">
           <StackPanel>
            <Grid Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="CPU fan" FontSize="12" VerticalAlignment="Center"/><Slider x:Name="CpuSlider" Grid.Column="1" Minimum="20" Maximum="100" Value="60" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="CPU fan speed percentage"/><TextBlock x:Name="CpuSpeedLabel" Grid.Column="2" Text="60%" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#B6C4FF"/></Grid>
            <Grid Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="GPU fan" FontSize="12" VerticalAlignment="Center"/><Slider x:Name="GpuSlider" Grid.Column="1" Minimum="20" Maximum="100" Value="60" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="GPU fan speed percentage"/><TextBlock x:Name="GpuSpeedLabel" Grid.Column="2" Text="60%" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#B6C4FF"/></Grid>
            <Button x:Name="ApplyCustom" Content="Apply fan speeds" FontSize="12" Padding="12,6" HorizontalAlignment="Right" Margin="0,4,0,0"/>
           </StackPanel>
          </Border>
          <Button x:Name="VerifyOverview" Content="Enable controls on this laptop" FontSize="12" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed"/>
          <Border Height="1" Background="#344155" Margin="0,12,0,12"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><TextBlock Text="CoolBoost" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="BoostOn" Grid.Column="1" Content="On" AutomationProperties.Name="Enable CoolBoost" Padding="8,6" FontSize="12" IsEnabled="False" Margin="0,0,6,0"/><Button x:Name="BoostOff" Grid.Column="2" Content="Off" AutomationProperties.Name="Disable CoolBoost" Padding="8,6" FontSize="12" IsEnabled="False"/></Grid>
          <TextBlock x:Name="CoolBoostState" Text="Checking firmware…" Style="{StaticResource Small}" Margin="0,8,0,0"/>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Padding="16" Margin="0,14,0,0">
         <StackPanel>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Power profile" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="PowerPlan" Grid.Column="1" Text="—" Foreground="#B6C4FF" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="PowerPlans" FontSize="13" Padding="8,7" Margin="0,0,8,0" Foreground="#151B26" AutomationProperties.Name="Installed Windows power plans"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#151B26" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="ApplyPower" Grid.Column="1" Content="Apply" Padding="12,7" FontSize="12" IsEnabled="False" AutomationProperties.Name="Apply power plan"/></Grid>
          <TextBlock x:Name="PowerStatus" Text="Checking Windows power plans…" Style="{StaticResource Small}" Margin="0,8,0,0"/>
         </StackPanel>
        </Border>
       </StackPanel>
      </Grid>
     </ScrollViewer>
     <ScrollViewer x:Name="DevicePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Panel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DeviceModel" Text="Your laptop" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="DeviceDetails" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><Button x:Name="VerifyFan" Content="Verify fan control on this laptop" Margin="0,0,10,0" Visibility="Collapsed"/><Button x:Name="CheckAgain" Content="Check again"/></StackPanel></Grid></Border><TextBlock Text="Support is checked by feature. Your model name does not block access." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,18"/><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Features on this laptop" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="FeatureRows"/><Border BorderBrush="#344155" BorderThickness="0,1,0,0" Padding="0,14,0,0"><TextBlock Text="Lighting and extra controls depend on your device. Their presence in another Acer app does not establish support here." Foreground="{StaticResource Muted}" FontSize="12"/></Border></StackPanel></Border><Grid Margin="0,18,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Trying another Acer?" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Start with a support check. Available sensors can be used even when fan control is unverified." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,20,0"/></StackPanel><Button x:Name="SummaryButton" Grid.Column="1" Content="Preview support summary" VerticalAlignment="Center"/></Grid></StackPanel></ScrollViewer>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Monitoring" Style="{StaticResource SectionTitle}"/><TextBlock Text="Temperature units" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,22"><Button x:Name="CelsiusButton" Content="Celsius  °C" Width="145" Margin="0,0,12,0"/><Button x:Name="FahrenheitButton" Content="Fahrenheit  °F" Width="145"/></StackPanel><TextBlock Text="Reading interval" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="Refresh2" Content="2 seconds" Margin="0,0,10,0"/><Button x:Name="Refresh5" Content="5 seconds" Margin="0,0,10,0"/><Button x:Name="Refresh10" Content="10 seconds"/></StackPanel><TextBlock Text="A longer interval reduces polling. Temperature history stays in memory for this session." Style="{StaticResource Small}" Margin="0,14,0,0"/></StackPanel></Border><Border Style="{StaticResource Panel}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Window behavior" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="TrayCheck" Content="Keep running in the tray when I close the window"/><TextBlock Text="Exit from the tray menu to close Aero Control completely." Style="{StaticResource Small}"/></StackPanel></Border><Border Style="{StaticResource Panel}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Aero Control 0.3" Style="{StaticResource SectionTitle}"/><TextBlock Text="An independent community interface for supported Acer hardware. This preview uses your existing Acer service. No Acer application files are included." Foreground="{StaticResource Muted}"/><TextBlock Text="Dark appearance · Portable Windows build" Style="{StaticResource Small}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#2B3648" BorderThickness="0,1,0,0" Background="#18212E" Padding="20,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Fill="#E7B690" Width="8" Height="8" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionStatus" Text="Checking connection" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel><TextBlock x:Name="LastReading" Text="Waiting for first reading" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Aero Control 0.3 · Community preview" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
 </Border>
</Window>
